#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>
#include <Adafruit_MLX90614.h>
#include <DHT.h>

// --- PIN DEFINITIONS ---
#define OLED_SDA 21
#define OLED_SCL 22
#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
#define OLED_RESET -1
#define SCREEN_ADDRESS 0x3C

#define THERMAL_SDA 18
#define THERMAL_SCL 19

#define DHTPIN 4
#define DHTTYPE DHT11

// --- BUS & SENSOR OBJECTS ---
TwoWire I2C_OLED = TwoWire(0);
TwoWire I2C_Thermal = TwoWire(1);

Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &I2C_OLED, OLED_RESET);
Adafruit_MLX90614 mlx = Adafruit_MLX90614();
DHT dht(DHTPIN, DHTTYPE);

// --- NON-BLOCKING TIMERS ---
unsigned long lastDisplayUpdate = 0;
unsigned long lastDHTUpdate = 0;

// Shared sensor data variables
float irTemp = 0.0;
bool irValid = false;
float dhtTemp = 0.0;
float dhtHum = 0.0;

void setup() {
  Serial.begin(115200);
  delay(200);

  // Initialize I2C Buses
  I2C_OLED.begin(OLED_SDA, OLED_SCL, 100000);
  I2C_Thermal.begin(THERMAL_SDA, THERMAL_SCL, 50000);

  // Prevent I2C bus hangs by lowering communication timeout to 50ms
  I2C_Thermal.setTimeOut(50);

  dht.begin();

  if (!display.begin(SSD1306_SWITCHCAPVCC, SCREEN_ADDRESS)) {
    Serial.println(F("OLED Init Failed!"));
    while (true);
  }
  
  display.clearDisplay();
  display.display();

  if (mlx.begin(0x5A, &I2C_Thermal)) {
    Serial.println(F("Thermal Sensor Ready."));
  } else {
    Serial.println(F("Thermal Sensor Failed at Boot!"));
  }
}

void loop() {
  unsigned long currentMillis = millis();

  // 1. FAST LOOP: Read IR Sensor every 200ms
  if (currentMillis - lastDisplayUpdate >= 200) {
    lastDisplayUpdate = currentMillis;

    float rawIR = mlx.readObjectTempC();
    
    // Check if value is valid without calling blocking re-init functions
    if (!isnan(rawIR) && rawIR > -40.0 && rawIR < 300.0) {
      irTemp = rawIR;
      irValid = true;
    } else {
      irValid = false;
    }

    // Update Display Output
    renderScreen();
  }

  // 2. SLOW LOOP: Read DHT11 Sensor every 2000ms
  if (currentMillis - lastDHTUpdate >= 2000) {
    lastDHTUpdate = currentMillis;

    float rawDHTTemp = dht.readTemperature();
    float rawDHTHum = dht.readHumidity();

    if (!isnan(rawDHTTemp)) dhtTemp = rawDHTTemp;
    if (!isnan(rawDHTHum)) dhtHum = rawDHTHum;
  }
}

void renderScreen() {
  display.clearDisplay();
  display.drawRect(0, 0, SCREEN_WIDTH, SCREEN_HEIGHT, SSD1306_WHITE);

  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);
  display.setCursor(14, 5);
  display.println("SYSTEM MONITOR");
  display.drawLine(6, 15, 122, 15, SSD1306_WHITE);

  // Line 1: IR Thermal Sensor
  display.setCursor(8, 20);
  display.print("IR Temp : ");
  if (irValid) {
    display.print(irTemp, 1);
    display.println(" C");
  } else if (irTemp != 0.0) {
    display.print(irTemp, 1);
    display.println(" C ?"); // Flag last known value if read failed
  } else {
    display.println("ERR / BUSY");
  }

  // Line 2: DHT Temp
  display.setCursor(8, 34);
  display.print("Air Temp: ");
  display.print(dhtTemp, 1);
  display.println(" C");

  // Line 3: DHT Humidity
  display.setCursor(8, 48);
  display.print("Humidity: ");
  display.print(dhtHum, 1);
  display.println(" %");

  display.display();
}
